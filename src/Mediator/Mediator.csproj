<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    
    <!-- Package Info -->
    <PackageId>Mediator.Slim</PackageId>
    <Version>2.0.0</Version>
    <Authors>MediatR</Authors>
    <Description>High-performance Mediator pattern implementation for .NET with CQRS support</Description>
    <PackageTags>mediator;cqrs;messaging;pipeline</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Performance optimizations -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.12" />
  </ItemGroup>

</Project>
